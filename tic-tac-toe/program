board = ["1", "2", "3", "4", "5", "6", "7", "8", "9"]
current_player = "X"

print("Welcome to Tic-Tac-Toe!")

for turn in range(9):

    print(f"\n {board[0]} | {board[1]} | {board[2]} ")
    print("---|---|---")
    print(f"\n {board[3]} | {board[4]} | {board[5]} ")
    print("---|---|---")
    print(f"\n {board[6]} | {board[7]} | {board[8]} \n")

 
    while True:
        choice = input(f"Player {current_player}, choose an open spot (1-9): ")
        if choice in board:
           
            board[board.index(choice)] = current_player
            break
        print("Invalid move! Try again.")

   
    win_conditions = [[0,1,2],[3, 4, 5], [6, 7, 8], [1, 4, 7], [2, 5, 8],  [2, 4, 6],[0,3,6],[0,4,8] ]
   
    winner_found = False
    for combo in win_conditions:
        if board[combo[0]] == board[combo[1]] == board[combo[2]] == current_player:
            winner_found = True
            break

    if winner_found:
     
        print(f"\n {board[0]} | {board[1]} | {board[2]} \n---|---|---\n {board[3]} | {board[4]} | {board[5]} \n---|---|---\n {board[6]} | {board[7]} | {board[8]} \n")
        print(f" Player {current_player} wins the game!")
        break

   
    if current_player == "X":
        current_player = "O"
    else:
        current_player = "X"
else:
   
    print(" It's a draw!")
